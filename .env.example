# Field Shift - Environment Configuration
# Never commit .env with real credentials!

# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# NASA Earthdata (Optional for MVP cached data; needed for live SMAP / ECOSTRESS / IMERG queries)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Climate Data Store (Optional for live ERA5)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Cache Settings
CACHE_DIR=./backend/app/cache
ENABLE_DISK_CACHE=true
